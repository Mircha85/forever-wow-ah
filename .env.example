# APP_URL: The URL where this applet is hosted.
# Production lives on Vercel Hobby. Set this to the auto-assigned
# https://<project>.vercel.app URL (or the custom domain after the DNS swap).
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_VERCEL_APP_URL"

# PIPELINE_RUN_TOKEN: Required in production. Bearer secret for POST /api/pipeline/run.
# Generate with:  openssl rand -base64 32  (or any 32-byte random source, base64url-safe).
# The token is compared with crypto.timingSafeEqual; requests without a matching
# Authorization: Bearer <token> header get 401. Production refuses to start if
# this variable is empty. Local dev may leave it unset; the route falls open
# only when NODE_ENV !== 'production'.
PIPELINE_RUN_TOKEN=""

# BLIZZARD API: Optional for connecting live Battle.net OAuth2 API
# If omitted, application runs seamlessly with WoW: Forever high-fidelity snapshots
BLIZZARD_CLIENT_ID=""
BLIZZARD_CLIENT_SECRET=""
BLIZZARD_REGION="eu"

# CLOUDFLARE R2: Optional S3-compatible bucket credentials for production CDN storage
# If omitted, application uses fast in-memory ephemeral caching
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="wow-forever-ah-cache"
R2_PUBLIC_DOMAIN=""

